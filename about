            }
        };

        const langToggleBtn = document.getElementById('langToggle');
        const langLabel = document.getElementById('langLabel');

        function setLanguage(lang) {
            localStorage.setItem('masar_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            langLabel.textContent = (lang === 'ar') ? 'English' : 'العربية';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[lang] && i18n[lang][key]) {
                    el.textContent = i18n[lang][key];
                }
            });
        }

        langToggleBtn.addEventListener('click', () => {
            const current = localStorage.getItem('masar_lang') || 'en';
            setLanguage(current === 'en' ? 'ar' : 'en');
        });

        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('masar_lang') || 'en';
            setLanguage(savedLang);
        });
    </script>
