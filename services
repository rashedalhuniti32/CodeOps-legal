            ar: {
                nav_home: "الرئيسية", nav_services: "الاختصاصات", nav_about: "عن مسار", nav_team: "فريق العمل", nav_contact: "تواصل معنا", cta_header: "تحدث مع محامٍ",
                hero_badge: "مجالات الاختصاص", hero_title: "ركائز الممارسة القانونية المؤسسية", hero_desc: "نقدم عمليات قانونية وتنفيذية متكاملة للشركات الأجنبية في الأردن.",
                p1_title: "تأسيس وتسجيل الشركات", p1_sub: "تشكيل الكيانات وترخيص الفروع الإقليمية.",
                p1_desc: "ندير دورة الهيكلة المؤسسية في الأردن بالكامل: صياغة عقود التأسيس ثنائية اللغة، وإدارة الوكالات الرسمية والتصديقات القنصلية.",
                note_title: "ملاحظة اختصاص إجرائية", p1_note: "يتطلب تسجيل فرع أجنبي في الأردن وثائق مصدقة من الخارجية والسفارة الأردنية. نحن نتولى إدارة إجراءات التصديق المحلي مباشرة نيابة عنكم.",
                p2_title: "عقود التوظيف عن بُعد والملكية", p2_sub: "عقود محكمة لفرق العمل التقنية والموظفين المستقلين.",
                p2_desc: "يحمل توظيف الكفاءات المحلية عبر كيانات أجنبية مخاطر عمالية وضريبية. نقوم بصياغة عقود عمل ثنائية اللغة تضمن النقل التام للملكية الفكرية والامتثال لقانون العمل.",
                p2_note: "بموجب القانون الأردني، تخضع شروط عدم المنافسة لتدقيق صارم، ولا تُعد نافذة إلا إذا كانت مقيدة بوضوح من حيث المدة والجغرافيا ونطاق العمل الدقيق.",
