                p3_desc: "نعمل كذراع للامتثال لقانون حماية البيانات الشخصية الأردني، حيث ندقق عمليات نقل البيانات ونمثل الشركات أمام الجهات التنظيمية.",
                p3_note: "يُلزم قانون حماية البيانات الكيانات الأجنبية التي تعالج بيانات مقيمين في الأردن بتعيين ممثل محلي معتمد للتعامل مع الاستفسارات وإشعارات الاختراق.",
                p4_title: "التقاضي التجاري وحل النزاعات", p4_sub: "التمثيل القضائي المباشر والاشتراكات الشهرية.",
                p4_desc: "بقيادة محامين مزاولين، نمثل الشركات في النزاعات التجارية، مطالبات الإخلال بالعقود، والقضايا العمالية، مع إعطاء الأولوية للتسويات الودية الحاسمة.",
                p4_note: "تُنظر النزاعات المؤسسية ذات القيمة العالية من خلال الغرف التجارية المتخصصة في محاكم عمان، والتي أُسست لتسريع التقاضي وحماية الاستثمارات.",
                footer_loc: "عَمّان، الأردن", footer_rights: "© 2026 MASAR للحلول القانونية. جميع الحقوق محفوظة."
            }
        };

        const langToggleBtn = document.getElementById('langToggle');
        const langLabel = document.getElementById('langLabel');

        function setLanguage(lang) {
            localStorage.setItem('masar_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            langLabel.textContent = (lang === 'ar') ? 'English' : 'العربية';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[lang] && i18n[lang][key]) {
                    el.textContent = i18n[lang][key];
                }
            });
        }

        langToggleBtn.addEventListener('click', () => {
            const current = localStorage.getItem('masar_lang') || 'en';
            setLanguage(current === 'en' ? 'ar' : 'en');
        });

        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('masar_lang') || 'en';
            setLanguage(savedLang);
        });
    </script>
