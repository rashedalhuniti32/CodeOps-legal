<!DOCTYPE html>
<html lang="en" dir="ltr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | MASAR Legal Solutions</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: { 900: '#0A1424', 800: '#111D32', 700: '#1A2A45' },
                        sand: { 50: '#FAF8F5', 500: '#C5A880', 600: '#B0936C' },
                        slate: { 50: '#F8FAFC', 800: '#1E293B' }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        arabic: ['"IBM Plex Sans Arabic"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        [dir="rtl"] { font-family: 'IBM Plex Sans Arabic', sans-serif; text-align: right; }
        [dir="rtl"] h1, [dir="rtl"] h2, [dir="rtl"] h3 { line-height: 1.45 !important; }
        [dir="rtl"] .text-start { text-align: right; }
        [dir="ltr"] .text-start { text-align: left; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-sand-500 selection:text-white">

    <header class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-md border-b border-navy-700/60">
        <div class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex items-center justify-between">
            <a href="index.html" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-sand-500 flex items-center justify-center font-bold text-navy-900 text-xl">M</div>
                <div>
                    <span class="text-white font-bold tracking-tight text-base sm:text-lg block">MASAR</span>
                    <span class="text-[10px] text-sand-500 font-semibold tracking-wider block uppercase">Legal Solutions</span>
                </div>
            </a>
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <a href="index.html" class="hover:text-sand-500 transition" data-i18n="nav_home">Home</a>
                <a href="services.html" class="hover:text-sand-500 transition" data-i18n="nav_services">Services</a>
                <a href="about.html" class="hover:text-sand-500 transition" data-i18n="nav_about">About</a>
                <a href="team.html" class="hover:text-sand-500 transition" data-i18n="nav_team">Team</a>
                <a href="contact.html" class="text-sand-500 transition" data-i18n="nav_contact">Contact</a>
            </nav>
            <div class="flex items-center gap-4">
                <button id="langToggle" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-navy-700 text-slate-300 hover:text-white hover:border-sand-500 transition">
                    <span id="langLabel">العربية</span>
                </button>
            </div>
        </div>
    </header>

    <section class="relative bg-navy-900 py-20 px-5 sm:px-8 overflow-hidden min-h-[calc(100vh-80px)] flex flex-col justify-center">
        <!-- Background with Lawyers/Business Attire in Dark Navy Overlay -->
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32b7?q=80&w=2070&auto=format&fit=crop" alt="Legal Consultation" class="w-full h-full object-cover opacity-25 filter grayscale contrast-125 mix-blend-luminosity">
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/90 to-navy-900/70"></div>
        </div>

        <div class="relative z-10 max-w-3xl mx-auto text-center mb-12">
            <span class="text-xs uppercase font-bold tracking-widest text-sand-500 mb-4 block" data-i18n="contact_badge">Confidential Intake</span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6" data-i18n="contact_title">Direct Inquiry</h1>
            <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto" data-i18n="contact_desc">All communications are bound by strict legal privilege and professional non-disclosure.</p>
        </div>

        <div class="relative z-10 max-w-2xl mx-auto w-full">
            <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="bg-navy-800/80 backdrop-blur-md p-6 sm:p-10 rounded-2xl shadow-2xl space-y-6 border border-navy-700">
                
                <div class="grid sm:grid-cols-2 gap-6">
                    <div class="text-start">
                        <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide" data-i18n="form_name">Full Name</label>
                        <input type="text" name="name" required class="w-full bg-navy-900/60 border border-navy-700 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sand-500 transition" placeholder="John Doe">
                    </div>
                    <div class="text-start">
                        <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide" data-i18n="form_email">Corporate Email</label>
                        <input type="email" name="email" required class="w-full bg-navy-900/60 border border-navy-700 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sand-500 transition" placeholder="john@company.com">
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-6">
                    <div class="text-start">
                        <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide" data-i18n="form_company">Organization</label>
                        <input type="text" name="company" class="w-full bg-navy-900/60 border border-navy-700 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sand-500 transition" placeholder="Company name">
                    </div>
                    <div class="text-start">
                        <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide" data-i18n="form_subject">Matter of Interest</label>
                        <select name="subject" class="w-full bg-navy-900/60 border border-navy-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-sand-500 transition cursor-pointer">
                            <option value="corporate_setup" data-i18n="opt_1">Company Setup & Structuring</option>
                            <option value="employment" data-i18n="opt_2">Employment & Remote Contracts</option>
                            <option value="privacy" data-i18n="opt_3">Regulatory & Data Privacy (PDPL)</option>
                            <option value="dispute" data-i18n="opt_4">Commercial Dispute / Litigation</option>
                            <option value="other" data-i18n="opt_5">General Legal Inquiry</option>
                        </select>
                    </div>
                </div>

                <div class="text-start">
                    <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide" data-i18n="form_msg">Brief Context</label>
                    <textarea name="message" rows="4" class="w-full bg-navy-900/60 border border-navy-700 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sand-500 transition resize-none" placeholder="Provide a brief outline of your operational requirements or legal inquiry..."></textarea>
                </div>

                <button type="submit" class="w-full bg-sand-500 hover:bg-sand-600 text-navy-900 font-bold py-4 rounded-xl text-sm transition duration-150 shadow-sm mt-2" data-i18n="form_submit">
                    Request Advisory Consultation
                </button>
            </form>
        </div>
    </section>

    <footer class="bg-navy-950 text-slate-500 py-10 px-5 sm:px-8 border-t border-navy-900 text-xs">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center text-start">
            <div>
                <span class="text-slate-300 font-semibold">MASAR Legal Solutions</span>
                <span class="mx-2">•</span>
                <span data-i18n="footer_location">Amman, Jordan</span>
            </div>
            <div class="text-slate-500" data-i18n="footer_rights">
                © 2026 MASAR Legal Solutions. All rights reserved.
            </div>
        </div>
    </footer>

    <script>
        const i18n = {
            en: {
                nav_home: "Home", nav_services: "Services", nav_about: "About", nav_team: "Team", nav_contact: "Contact",
                contact_badge: "Confidential Intake", contact_title: "Direct Inquiry",
                contact_desc: "All communications are bound by strict legal privilege and professional non-disclosure.",
                form_name: "Full Name", form_email: "Corporate Email", form_company: "Organization", form_subject: "Matter of Interest",
                opt_1: "Company Setup & Structuring", opt_2: "Employment & Remote Contracts", opt_3: "Regulatory & Data Privacy (PDPL)", opt_4: "Commercial Dispute / Litigation", opt_5: "General Legal Inquiry",
                form_msg: "Brief Context", form_submit: "Request Advisory Consultation",
                footer_location: "Amman, Jordan", footer_rights: "© 2026 MASAR Legal Solutions. All rights reserved."
            },
            ar: {
                nav_home: "الرئيسية", nav_services: "الاختصاصات", nav_about: "عن مسار", nav_team: "فريق العمل", nav_contact: "تواصل معنا",
                contact_badge: "استقبال استشارات سرية", contact_title: "طلب استشارة مباشرة",
                contact_desc: "تخضع جميع الاتصالات لسرية المحاماة التامة والتزامات عدم الإفصاح المهنية.",
                form_name: "الاسم الكامل", form_email: "البريد الإلكتروني للعمل", form_company: "اسم الشركة / المؤسسة", form_subject: "طبيعة الموضوع",
                opt_1: "تأسيس شركة أو تسجيل فرع", opt_2: "عقود التوظيف والفرق عن بُعد", opt_3: "الامتثال لقانون حماية البيانات", opt_4: "نزاع تجاري أو تمثيل قضائي", opt_5: "استفسار قانوني عام",
                form_msg: "تفاصيل موجزة", form_submit: "إرسال طلب الاستشارة",
                footer_location: "عَمّان، الأردن", footer_rights: "© 2026 MASAR للحلول القانونية. جميع الحقوق محفوظة."
            }
        };

        const langToggleBtn = document.getElementById('langToggle');
        const langLabel = document.getElementById('langLabel');

        function setLanguage(lang) {
            localStorage.setItem('masar_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            langLabel.textContent = (lang === 'ar') ? 'English' : 'العربية';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[lang] && i18n[lang][key]) {
                    el.textContent = i18n[lang][key];
                }
            });
        }

        langToggleBtn.addEventListener('click', () => {
            const current = localStorage.getItem('masar_lang') || 'en';
            setLanguage(current === 'en' ? 'ar' : 'en');
        });

        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('masar_lang') || 'en';
            setLanguage(savedLang);
        });
    </script>
</body>
</html>
