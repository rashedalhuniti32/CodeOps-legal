<!DOCTYPE html>
<html lang="en" dir="ltr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Masar Legal Solutions</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: { 900: '#0A1424', 800: '#111D32', 700: '#1A2A45' },
                        sand: { 50: '#FAF8F5', 500: '#C5A880', 600: '#B0936C' },
                        slate: { 50: '#F8FAFC', 800: '#1E293B' }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        arabic: ['"IBM Plex Sans Arabic"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body.lang-ar { font-family: 'IBM Plex Sans Arabic', sans-serif; line-height: 1.75; }
        .lang-ar h1, .lang-ar h2 { line-height: 1.5; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-sand-500 selection:text-white">

    <!-- Header (Shared) -->
    <header class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-md border-b border-navy-700/60">
        <div class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex items-center justify-between">
            <a href="index.html" class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-sand-500 flex items-center justify-center font-bold text-navy-900 text-lg shadow-sm">M</div>
                <div>
                    <span class="text-white font-bold tracking-tight text-base sm:text-lg block leading-none pt-1">MASAR</span>
                    <span class="text-[10px] text-sand-500 font-medium tracking-wide block uppercase mt-1" data-i18n="logo_sub">Legal Solutions</span>
                </div>
            </a>
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <a href="index.html" class="hover:text-sand-500 transition" data-i18n="nav_home">Home</a>
                <a href="services.html" class="hover:text-sand-500 transition" data-i18n="nav_services">Services</a>
                <a href="about.html" class="hover:text-sand-500 transition" data-i18n="nav_about">About</a>
                <a href="team.html" class="hover:text-sand-500 transition" data-i18n="nav_team">Team</a>
            </nav>
            <div class="flex items-center gap-4">
                <button id="langToggle" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-navy-700 text-slate-300 hover:text-white hover:border-sand-500 transition flex items-center gap-1.5">
                    <span id="langLabel">العربية</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <section class="relative bg-navy-900 py-20 px-5 sm:px-8 overflow-hidden">
        <!-- Abstract Image Background -->
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop" alt="Architecture" class="w-full h-full object-cover opacity-10 mix-blend-luminosity">
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/90 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-3xl mx-auto text-center mb-12">
            <span class="text-xs uppercase font-bold tracking-widest text-sand-500 mb-4 block" data-i18n="contact_badge">Confidential Intake</span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6" data-i18n="contact_title">Direct Inquiry</h1>
            <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto" data-i18n="contact_desc">All communications are bound by strict legal privilege and non-disclosure agreements.</p>
        </div>

        <div class="relative z-10 max-w-2xl mx-auto">
            <!-- Ensure to replace 'YOUR_FORM_ID' with your actual Formspree or Tally endpoint -->
            <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="bg-white p-6 sm:p-10 rounded-2xl shadow-xl space-y-6 border border-slate-200">
                
                <div class="grid sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide" data-i18n="form_name">Full Name</label>
                        <input type="text" name="name" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sand-500 focus:ring-1 focus:ring-sand-500 transition" placeholder="John Doe">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide" data-i18n="form_email">Corporate Email</label>
                        <input type="email" name="email" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sand-500 focus:ring-1 focus:ring-sand-500 transition" placeholder="john@company.com">
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide" data-i18n="form_company">Organization</label>
                        <input type="text" name="company" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sand-500 focus:ring-1 focus:ring-sand-500 transition" placeholder="Organization name">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide" data-i18n="form_subject">Matter of Interest</label>
                        <select name="subject" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sand-500 focus:ring-1 focus:ring-sand-500 transition appearance-none cursor-pointer">
                            <option value="corporate_setup" data-i18n="opt_1">Company Setup & Structuring</option>
                            <option value="employment" data-i18n="opt_2">Employment & Remote Contracts</option>
                            <option value="privacy" data-i18n="opt_3">Regulatory & Data Privacy (PDPL)</option>
                            <option value="dispute" data-i18n="opt_4">Commercial Dispute / Litigation</option>
                            <option value="other" data-i18n="opt_5">General Legal Inquiry</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide" data-i18n="form_msg">Brief Context</label>
                    <textarea name="message" rows="4" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sand-500 focus:ring-1 focus:ring-sand-500 transition resize-none" placeholder="Provide a brief outline of your operational needs or legal inquiry..."></textarea>
                </div>

                <button type="submit" class="w-full bg-sand-500 hover:bg-sand-600 text-navy-900 font-bold py-4 rounded-xl text-sm transition duration-150 shadow-sm mt-2" data-i18n="form_submit">
                    Request Advisory Consultation
                </button>
                <p class="text-center text-xs text-slate-500 mt-4 flex items-center justify-center gap-1.5">
                    <svg class="w-3 h-3 text-sand-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                    <span data-i18n="form_secure">End-to-End Secure Submission</span>
                </p>
            </form>
        </div>
    </section>

    <!-- Footer (Shared) -->
    <footer class="bg-navy-900 text-slate-400 py-10 px-5 sm:px-8 border-t border-navy-800 text-xs">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-center md:text-left rtl:md:text-right">
                <span class="text-white font-semibold">Masar Legal Solutions</span>
                <span class="mx-2 text-navy-700">|</span>
                <span data-i18n="footer_loc">Amman, Jordan</span>
            </div>
            <div class="flex items-center gap-6">
                <span data-i18n="footer_rights">© 2026 Masar Legal Solutions. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <!-- Bilingual Engine -->
    <script>
        const i18n = {
            en: {
                logo_sub: "Legal Solutions", nav_home: "Home", nav_services: "Services", nav_about: "About", nav_team: "Team",
                contact_badge: "Confidential Intake", contact_title: "Direct Inquiry", contact_desc: "All communications are bound by strict legal privilege and non-disclosure agreements.",
                form_name: "Full Name", form_email: "Corporate Email", form_company: "Organization", form_subject: "Matter of Interest",
                opt_1: "Company Setup & Structuring", opt_2: "Employment & Remote Contracts", opt_3: "Regulatory & Data Privacy (PDPL)", opt_4: "Commercial Dispute / Litigation", opt_5: "General Legal Inquiry",
                form_msg: "Brief Context", form_submit: "Request Advisory Consultation", form_secure: "End-to-End Secure Submission",
                footer_loc: "Amman, Jordan", footer_rights: "© 2026 Masar Legal Solutions. All rights reserved."
            },
            ar: {
                logo_sub: "حلول قانونية", nav_home: "الرئيسية", nav_services: "الاختصاصات", nav_about: "عن مسار", nav_team: "فريق العمل",
                contact_badge: "استقبال سري", contact_title: "طلب مباشر", contact_desc: "تخضع جميع الاتصالات لسرية المحامي وموكله واتفاقيات عدم الإفصاح الصارمة.",
                form_name: "الاسم الكامل", form_email: "البريد الإلكتروني للعمل", form_company: "اسم الشركة / المؤسسة", form_subject: "طبيعة الموضوع",
                opt_1: "تأسيس شركة أو تسجيل فرع", opt_2: "عقود التوظيف والفرق عن بُعد", opt_3: "الامتثال لقانون حماية البيانات", opt_4: "نزاع تجاري أو تمثيل قضائي", opt_5: "استفسار قانوني عام",
                form_msg: "تفاصيل موجزة", form_submit: "طلب استشارة أولية", form_secure: "إرسال آمن ومحمي بالكامل",
                footer_loc: "عَمّان، الأردن", footer_rights: "© 2026 مسار للحلول القانونية. جميع الحقوق محفوظة."
            }
        };

        let currentLang = 'en';
        const langToggleBtn = document.getElementById('langToggle');
        const langLabel = document.getElementById('langLabel');

        function setLanguage(lang) {
            currentLang = lang;
            document.documentElement.lang = lang;
            document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            
            if (lang === 'ar') {
                document.body.classList.add('lang-ar');
                langLabel.textContent = 'English';
            } else {
                document.body.classList.remove('lang-ar');
                langLabel.textContent = 'العربية';
            }

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[lang] && i18n[lang][key]) {
                    el.innerHTML = i18n[lang][key];
                }
            });
        }

        langToggleBtn.addEventListener('click', () => {
            setLanguage(currentLang === 'en' ? 'ar' : 'en');
        });
    </script>
</body>
</html>
